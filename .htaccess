# Velo — configuração do Apache (Hostinger)
# Este arquivo só funciona em servidor Apache. Na Hostinger (hospedagem
# compartilhada) ele vale automaticamente; em Netlify/Vercel/GitHub Pages é
# ignorado — lá a página de erro é achada de outro jeito.

# ---------------------------------------------------------------- página 404
# Sem isto o visitante que erra o endereço vê a tela cinza padrão do servidor
# em vez do tubarão. O caminho é a partir da raiz do domínio.
ErrorDocument 404 /404.html

# ------------------------------------------------------------- tipos de arquivo
# Servidor antigo às vezes não conhece woff2/webp/avif e manda como
# "application/octet-stream" — aí o navegador não usa o preload da fonte.
<IfModule mod_mime.c>
  AddType font/woff2  .woff2
  AddType image/webp  .webp
  AddType image/avif  .avif
  AddType image/svg+xml .svg
</IfModule>

# ------------------------------------------------------------------ compressão
# Texto comprime muito: o style.css cai de 70 KB pra uns 15 KB. Brotli quando
# o servidor tiver, gzip sempre. Foto e fonte (woff2) já vêm comprimidas —
# comprimir de novo só gasta CPU do servidor.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------- cache
# HTML sempre fresco (pra alteração no texto aparecer na hora).
# CSS e JS vêm com ?v=N no <script>/<link>: quando mudar um deles, suba o N
# nas páginas e todo mundo baixa o novo. Por isso podem ficar 30 dias.
# Imagem fica 30 dias porque o LEIA-ME manda trocar print "substituindo o
# arquivo", com o mesmo nome — cache longo demais seguraria a foto velha.
# Fonte tem a versão no nome do arquivo e nunca muda: um ano, imutável.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 7 days"
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 30 days"
  ExpiresByType application/javascript  "access plus 30 days"
  ExpiresByType text/javascript         "access plus 30 days"
  ExpiresByType image/png               "access plus 30 days"
  ExpiresByType image/jpeg              "access plus 30 days"
  ExpiresByType image/webp              "access plus 30 days"
  ExpiresByType image/avif              "access plus 30 days"
  ExpiresByType image/svg+xml           "access plus 30 days"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML: o navegador pode guardar, mas confere com o servidor antes de usar
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
